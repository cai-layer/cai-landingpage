  @keyframes blink { 50% { opacity: 0; } }

  /* ---------- 2. Cai review sheet ---------- */
  .sheet {
    position: absolute; left: 50%; top: 50%; width: 46%;
    padding: 1.3em 1.4em 1.2em; border-radius: 1.4em;
    background: linear-gradient(170deg, rgba(232,190,240,.92), rgba(242,182,214,.92));
