      <p class="badge fx" id="ha-badge">Ran on your Mac · no agent · no tokens</p>

      <div class="endcard on" id="ha-endcard"><svg viewBox="0 0 217 127" aria-hidden="true"><path d="M189.405 83.9031L216.831 83.9031C216.379 92.3868 214.066 99.8806 209.89 106.385C205.77 112.832 200.042 117.894 192.706 121.57C185.37 125.19 176.651 127 166.55 127C158.48 127 151.257 125.614 144.88 122.843C138.504 120.072 133.086 116.113 128.628 110.966C124.227 105.763 120.841 99.513 118.471 92.2171C116.157 84.8646 115 76.5789 115 67.3601L115 59.8096C115 50.5907 116.213 42.3051 118.64 34.9526C121.066 27.6001 124.537 21.3222 129.051 16.1189C133.566 10.9156 138.983 6.9283 145.304 4.15698C151.624 1.38566 158.678 0 166.466 0C176.962 0 185.822 1.89468 193.045 5.68403C200.268 9.47339 205.855 14.6767 209.805 21.2939C213.812 27.9112 216.21 35.4616 217 43.9452L189.49 43.9452C189.264 39.1378 188.361 35.094 186.781 31.8136C185.201 28.4767 182.774 25.9599 179.501 24.2632C176.228 22.5665 171.883 21.7181 166.466 21.7181C162.515 21.7181 159.045 22.4534 156.054 23.9238C153.119 25.3943 150.665 27.6849 148.69 30.7956C146.771 33.9063 145.332 37.8653 144.373 42.6727C143.413 47.4235 142.934 53.0793 142.934 59.6399L142.934 67.3601C142.934 73.8642 143.357 79.4916 144.203 84.2425C145.05 88.9933 146.404 92.9241 148.266 96.0347C150.185 99.1454 152.64 101.464 155.631 102.991C158.622 104.518 162.261 105.282 166.55 105.282C171.46 105.282 175.551 104.518 178.824 102.991C182.097 101.408 184.608 99.0323 186.358 95.8651C188.107 92.6978 189.123 88.7105 189.405 83.9031ZM32.7051 29.5L32.8506 29.7383L73.29 95.5781L101.5 95.5781L101.5 110.5L69.2949 110.5L69.1494 110.262L28.71 44.4219L0.5 44.4219L0.5 29.5ZM101.5 29.5L101.5 44.4219L69.0752 44.4219L69.0752 29.5Z"/></svg></div>

      <div class="cursor" id="ha-cursor"><svg viewBox="0 0 24 24"><path d="M4 2l16 10-7 1.5L9.5 21z" fill="#000" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/></svg></div>
    </div>
</div>

<script>

  const $ = (id: string) => document.getElementById('ha-' + id) as HTMLElement;
  const stage = $('stage');
  if (stage) {
  const cursor = $('cursor');
  const PROMPT = 'make me a Cai action that stops me from getting fired';
  const ANGRY = 'As I said THREE TIMES already, the button is BLUE. Did anyone open the spec??';
  const CALM = 'Great catch! The spec has it in blue 💙 Happy to walk through it anytime 🙏';

  let run = 0; // bumps on restart so a stale loop stops
  const wait = (ms: number, id: number) => new Promise<void>((res, rej) => setTimeout(() => (id === run ? res() : rej('stale')), ms));
  const on = (...els: HTMLElement[]) => els.forEach((e) => e.classList.add('on'));
  const off = (...els: HTMLElement[]) => els.forEach((e) => e.classList.remove('on'));
  const show = (...els: HTMLElement[]) => els.forEach((e) => e.classList.remove('gone'));
  const hide = (...els: HTMLElement[]) => els.forEach((e) => e.classList.add('gone'));
  const beat = (_t: string) => {};

  type Point = [number, number];
  let cx = 0, cy = 0;
  function at(el: HTMLElement, fx = 0.5, fy = 0.5): Point {
    const s = stage.getBoundingClientRect(), r = el.getBoundingClientRect();
    return [r.left - s.left + r.width * fx, r.top - s.top + r.height * fy];
  }
  async function move(point: Point, ms: number, id: number) {
    [cx, cy] = point;
    cursor.style.transitionDuration = ms + 'ms';
    cursor.style.transform = `translate(${cx}px, ${cy}px)`;
    await wait(ms, id);
  }
  function jump(point: Point) {
    [cx, cy] = point;
    cursor.style.transitionDuration = '0ms';
    cursor.style.transform = `translate(${cx}px, ${cy}px)`;
  }
  async function click(el: HTMLElement | null, id: number) {
    cursor.classList.add('down');
    el && el.classList.add('pressed');
    await wait(140, id);
    cursor.classList.remove('down');
    el && el.classList.remove('pressed');
  }
  // Human-ish typing: jittered speed, longer pause after punctuation.
  async function type(el: HTMLElement, text: string, perChar: number, id: number) {
    el.textContent = '';
    for (const ch of text) {
      el.textContent += ch;
      const pause = /[,.?!:]/.test(ch) ? perChar * 4 : perChar * (0.5 + Math.random());
      await wait(pause, id);
    }
  }

  function reset() {
    stage.querySelectorAll('.on:not(.endcard)').forEach((e) => e.classList.remove('on'));
    $('term').classList.remove('back');
    $('termTyped').textContent = '';
    hide($('echo'), $('calling'), $('done'), $('spinner'));
    $('draft').textContent = '';
    $('draft').classList.remove('selected', 'fade');
    $('draftCaret').style.display = '';
    $('send').classList.add('empty');
    $('search').textContent = '';
    stage.querySelectorAll('[data-other]').forEach((r) => r.classList.remove('gone'));
    stage.querySelector('[data-match]')!.classList.add('hl');
    $('sentText').textContent = '';
    $('newNote').classList.remove('settled');
    $('slack').classList.remove('shift');
    cursor.classList.remove('on');
  }

  async function play(id: number) {
    reset();
    jump(at(stage, 0.8, 0.9));

    // 1. Ask the agent
    beat('1 · agent');
    off($('endcard'));
    on($('term'));
    await wait(500, id);
    await type($('termTyped'), PROMPT, 38, id);
    await wait(350, id);
    $('echoText').textContent = PROMPT;
    $('termTyped').textContent = '';
    show($('echo'), $('calling'), $('spinner'));
    const words = ['Thundering…', 'Polishing…', 'Churning…'];
    const glyphs = ['✱', '✳', '✶', '✻'];
    for (let k = 0; k < 6; k++) {
      $('spinGlyph').textContent = glyphs[k % glyphs.length];
      $('spinWord').textContent = words[Math.floor(k / 3) % words.length];
      await wait(220, id);
    }
    hide($('calling'), $('spinner'));
    show($('done'));
    await wait(2500, id);

    // 2. Approve in Cai
    beat('2 · approve');
    $('term').classList.add('back');
    on($('sheet'), cursor);
    await wait(450, id);
    await wait(500, id);
    await move(at($('approve')), 700, id);
    await click($('approve'), id);
    await wait(300, id);
    off($('sheet'), $('term'), cursor);
    await wait(450, id);

    // 3. Slack: rage typing
    beat('3 · rage typing');
    on($('slack'));
    await wait(600, id);
    $('send').classList.remove('empty');
    await type($('draft'), ANGRY, 36, id);
    await wait(250, id);

    // reach for Send... hesitate... back off
    beat('4 · hesitate');
    jump(at($('slack'), 0.6, 1.05));
    on(cursor);
    await move(at($('send'), 0.15, 0.5), 850, id);
    await wait(200, id);
    const sx = cx, sy = cy;
    await move([sx - 40, sy + 10], 380, id);
    await wait(250, id);
    await move([sx - 4, sy + 1], 300, id);
    await wait(350, id);
    await move([sx - 70, sy + 18], 420, id);
    await wait(300, id);

    // select it, ⌥C
    beat('5 · select + ⌥C');
    $('draftCaret').style.display = 'none';
    await move(at($('draft'), 1, 0.7), 550, id);
    cursor.classList.add('down');
    $('draft').classList.add('selected');
    await move(at($('draft'), 0, 0.3), 500, id);
    cursor.classList.remove('down');
    await wait(250, id);
    on($('keycap'));
    await wait(450, id);
    on($('panel'));
    await wait(500, id);
    off($('keycap'));
    await wait(900, id);
    off($('panel'));

    // replaced in place, then sent
    beat('6 · calm, send');
    $('draft').classList.remove('selected');
    $('draft').classList.add('fade');
    await wait(300, id);
    $('draft').textContent = CALM;
    $('draft').classList.remove('fade');
    await wait(1200, id);
    await move(at($('send'), 0.3, 0.5), 450, id);
    await click($('send'), id);
    $('sentText').textContent = CALM;
    on($('sent'));
    $('draft').textContent = '';
    $('send').classList.add('empty');
    $('draftCaret').style.display = '';
    await wait(700, id);
    off(cursor);

    // the original lands in Notes
    beat('7 · notes');
    $('slack').classList.add('shift');
    on($('notes'));
    await wait(500, id);
    on($('newNote'));
    await wait(500, id);
    on($('badge'));
    await wait(1400, id);
    $('newNote').classList.add('settled');
    await wait(2600, id);

    beat('end card');
    on($('endcard'));
    await wait(700, id);
    reset();
    await wait(2300, id);
  }

  async function loop() {
    const id = ++run;
    try { while (true) await play(id); } catch (e) { if (e !== 'stale') throw e; }
  }

  // Reduced motion: hold the closing frame (reply sent, original kept in Notes).
  function stillFrame() {
    reset();
    off($('endcard'));
    $('draft').textContent = '';
    $('sentText').textContent = CALM;
    $('slack').classList.add('shift');
    on($('slack'), $('sent'), $('notes'), $('newNote'), $('badge'));
    $('newNote').classList.add('settled');
  }

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    stillFrame();
  } else {
    // Only run while on screen; start from the top each time it comes back.
    let visible = false;
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting === visible) return;
      visible = entry.isIntersecting;
      if (visible) loop();
      else { run++; on($('endcard')); }
    }, { threshold: 0.2 }).observe(stage);
  }
  }
</script>

<style>
  .ha { container-type: inline-size; width: 100%; }
  .stage {
    --indigo: #6366F2;
    --mac-blue: #3478F6;
    position: relative; aspect-ratio: 1280 / 804; overflow: hidden;
    font-size: 1.45cqw; color: #1d1d1f;
    background: linear-gradient(155deg, #A68CF8 0%, #C08ADB 40%, #DE88B4 75%, #F2899A 100%);
  }
  .stage * { box-sizing: border-box; }
  .stage p, .stage h3, .stage h4, .stage ul { margin: 0; }

  .fx { opacity: 0; transition: opacity .4s ease, transform .5s cubic-bezier(.2,.8,.2,1); }
  .fx.on { opacity: 1; }
  .gone { display: none !important; }

  /* ---------- macOS window chrome ---------- */
  .win { position: absolute; border-radius: 1em; overflow: hidden; box-shadow: 0 1.6em 4em rgba(60,20,80,.35), 0 0 0 1px rgba(0,0,0,.12); }
