  .sheet-title { font-size: 1.2em; font-weight: 600; color: #3a2d40; }
  .sheet-title span { color: #7a6680; font-weight: 600; }
  .sheet-sub { font-size: .8em; color: #8a7a90; margin: .25em 0 .5em !important; }
