  .bullet { color: #fff; }
  .bullet-grey { color: #9a9cab; }
  .spin { color: #D97757; }
  .term-input { margin-top: auto; border-top: 1px solid #555867; border-bottom: 1px solid #555867; padding: .45em 0; min-height: 2.3em; }
  .term-foot { color: #e5b93f; font-size: .95em; }
  .term-foot .muted { color: #9a9cab; }
