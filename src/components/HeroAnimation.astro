          <div class="p-row" data-other><span class="p-ic">ϟ</span><div><b>Ask AI</b><small>Ask AI anything about this content</small></div><kbd>⌘ 2</kbd></div>
          <div class="p-row" data-other><span class="p-ic">✓</span><div><b>Fix Grammar</b><small>Fix grammar, spelling, and punctuation</small></div><kbd>⌘ 3</kbd></div>
        </div>
        <div class="p-foot"><span><kbd>↑↓</kbd>Navigate</span><span><kbd>↵</kbd>Select</span><span><kbd>Esc</kbd>Close</span><span class="model">▣ Qwen3-4B-I…</span></div>
      </div>

      <span class="keycap fx" id="ha-keycap">⌥C</span>

      <!-- 4. Notes -->
