  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }

  /* ---------- 1. Claude Code in Terminal ---------- */
  .term { left: 9%; top: 8%; width: 62%; height: 62%; background: #282a36; transform: translateY(1.2em); display: flex; flex-direction: column; }
  .term.on { transform: none; }
  .term.back { opacity: .0; transform: scale(.96); }
  .term-bar { flex: none; height: 2.1em; display: flex; align-items: center; gap: .8em; padding: 0 .9em; background: #f6f6f6; border-bottom: 1px solid #d8d8d8; font-size: .85em; font-weight: 600; color: #3a3a3a; }
  .term-bar span { opacity: .85; }
  .term-body { flex: 1; position: relative; padding: .9em 1.2em; font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: .78em; line-height: 1.55; color: #e6e6e6; display: flex; flex-direction: column; gap: .8em; }
  .cc-head { display: flex; gap: 1em; align-items: center; }
